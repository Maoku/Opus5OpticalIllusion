{
  "name": "optical-illusion-museum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:hull": "node --experimental-strip-types tools/buildShadowHull.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "brace-expansion@5.0.8": "5.0.12",
    "brace-expansion@1.1.16": "1.1.21",
    "js-yaml@4.3.0": "4.3.2",
    "nanoid@3.3.16": "3.3.18",
    "source-map-js@1.2.1": "1.2.2"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
